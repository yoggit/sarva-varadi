{
  "name": "@sarva-varadi/core",
  "version": "1.1.7",
  "description": "Core library for Sarva-Varadi test reporter - common types, adapters, and report generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sarva-varadi": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "test-reporter",
    "test-automation",
    "html-report"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoggit/sarva-varadi.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/generators/varadi-styles.css",
    "src/generators/varadi-scripts.js"
  ],
  "dependencies": {
    "xml2js": "^0.6.2"
  },
  "peerDependencies": {
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.3.0"
  }
}
